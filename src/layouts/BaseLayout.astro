---
import '../styles/global.css';
import TopicIcon from '../components/TopicIcon.astro';
import { ecosystemLinks } from '../lib/topic-icon';
import { PROJECT_HERO } from '../lib/heroes';

interface Props {
  title?: string;
  description?: string;
  /** Absolute path or full URL for og:image / twitter:image */
  image?: string;
  /** open graph type — website | article */
  ogType?: 'website' | 'article';
  /** Prevent indexing when true */
  noindex?: boolean;
}

const {
  title = 'Sabor Brazil',
  description = 'Catálogo aberto de produtos e políticas onde o nome não é a coisa. Nem tudo é o que parece.',
  image,
  ogType = 'website',
  noindex = false,
} = Astro.props;

const pathname = Astro.url.pathname;
const site = Astro.site ?? new URL('https://sabor-brazil.vercel.app');
const canonical = new URL(pathname, site).href;
const defaultOg = new URL('/og-default.png', site).href;
const ogImage = image
  ? image.startsWith('http')
    ? image
    : new URL(image, site).href
  : defaultOg;
const isDefaultOg = ogImage === defaultOg;
const pageTitle = title.includes('Sabor Brazil') ? title : `${title} — Sabor Brazil`;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0a0a08" />
    <meta name="color-scheme" content="dark" />
    <meta name="author" content="Sabor Brazil" />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />

    <!-- Favicon & PWA -->
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <link rel="manifest" href="/site.webmanifest" />

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Sabor Brazil" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    {isDefaultOg && <meta property="og:image:width" content="1200" />}
    {isDefaultOg && <meta property="og:image:height" content="630" />}
    <meta property="og:image:alt" content={PROJECT_HERO.alt} />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={PROJECT_HERO.alt} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=DM+Mono:ital,wght@0,300;0,400;0,500;1,300&family=Playfair+Display:ital,wght@0,400;0,700;1,400&family=Source+Sans+3:wght@400;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <header class="site-header">
      <div class="wrap inner">
        <a class="brand" href="/">SABOR <span>BRAZIL</span></a>
        <nav class="nav" aria-label="Principal">
          <a href="/" aria-current={pathname === '/' ? 'page' : undefined}>
            <TopicIcon name="home" size={13} />
            Início
          </a>
          <a href="/trilha/rotulagem" aria-current={pathname.startsWith('/trilha/rotulagem') ? 'page' : undefined}>
            <TopicIcon name="tag" size={13} />
            Rotulagem
          </a>
          <a href="/trilha/regulatorio" aria-current={pathname.startsWith('/trilha/regulatorio') ? 'page' : undefined}>
            <TopicIcon name="scroll" size={13} />
            Regulatório
          </a>
          <a href="/trilha/institucional" aria-current={pathname.startsWith('/trilha/institucional') ? 'page' : undefined}>
            <TopicIcon name="landmark" size={13} />
            Institucional
          </a>
          <a href="/trilha/superfaturamento" aria-current={pathname.startsWith('/trilha/superfaturamento') ? 'page' : undefined}>
            <TopicIcon name="banknote" size={13} />
            Superfaturamento
          </a>
          <a href="/trilha/correlacao" aria-current={pathname.startsWith('/trilha/correlacao') ? 'page' : undefined}>
            <TopicIcon name="chart" size={13} />
            Correlação
          </a>
          <a href="/contribuir" aria-current={pathname.startsWith('/contribuir') ? 'page' : undefined}>
            <TopicIcon name="plus" size={13} />
            Encontrei um sabor
          </a>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <p class="footer-blurb">
          Conteúdo com fonte auditável. Hipótese nunca vira fato sem prova.
          Sugestões passam por curadoria — <a href="/contribuir">envie um caso</a>.
        </p>

        <p class="footer-eco-label">Este projeto faz parte do ecossistema</p>
        <div class="eco-grid">
          {
            ecosystemLinks.map((item) => (
              <a
                class:list={['eco-card', 'image' in item && item.image && 'eco-card--media']}
                href={item.href}
                target={item.current ? undefined : '_blank'}
                rel={item.current ? undefined : 'noopener noreferrer'}
                aria-current={item.current ? 'page' : undefined}
              >
                {'image' in item && item.image ? (
                  <span class="eco-thumb">
                    <img src={item.image} alt="" width="120" height="48" loading="lazy" />
                  </span>
                ) : (
                  <span class="eco-icon">
                    <TopicIcon name={item.icon} size={20} />
                  </span>
                )}
                <span class="eco-copy">
                  <span class="eco-title">{item.title}</span>
                  <span class="eco-desc">{item.description}</span>
                </span>
              </a>
            ))
          }
        </div>

        <div class="footdev">
          Desenvolvido por
          <a href="https://www.artesdosul.com/" target="_blank" rel="noopener noreferrer">Artes do Sul</a>
        </div>
      </div>
    </footer>
  </body>
</html>
