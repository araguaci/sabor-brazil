---
import '../styles/global.css';
import TopicIcon from '../components/TopicIcon.astro';
import { ecosystemLinks } from '../lib/topic-icon';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Sabor Brazil',
  description = 'Catálogo aberto de produtos e políticas onde o nome não é a coisa. Nem tudo é o que parece.',
} = Astro.props;

const pathname = Astro.url.pathname;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=DM+Mono:ital,wght@0,300;0,400;0,500;1,300&family=Playfair+Display:ital,wght@0,400;0,700;1,400&family=Source+Sans+3:wght@400;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <header class="site-header">
      <div class="wrap inner">
        <a class="brand" href="/">SABOR <span>BRAZIL</span></a>
        <nav class="nav" aria-label="Principal">
          <a href="/" aria-current={pathname === '/' ? 'page' : undefined}>
            <TopicIcon name="home" size={13} />
            Início
          </a>
          <a href="/trilha/rotulagem" aria-current={pathname.startsWith('/trilha/rotulagem') ? 'page' : undefined}>
            <TopicIcon name="tag" size={13} />
            Rotulagem
          </a>
          <a href="/trilha/regulatorio" aria-current={pathname.startsWith('/trilha/regulatorio') ? 'page' : undefined}>
            <TopicIcon name="scroll" size={13} />
            Regulatório
          </a>
          <a href="/trilha/institucional" aria-current={pathname.startsWith('/trilha/institucional') ? 'page' : undefined}>
            <TopicIcon name="landmark" size={13} />
            Institucional
          </a>
          <a href="/contribuir" aria-current={pathname.startsWith('/contribuir') ? 'page' : undefined}>
            <TopicIcon name="plus" size={13} />
            Encontrei um sabor
          </a>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <p class="footer-blurb">
          Conteúdo com fonte auditável. Hipótese nunca vira fato sem prova.
          Sugestões passam por curadoria — <a href="/contribuir">envie um caso</a>.
        </p>

        <p class="footer-eco-label">Este projeto faz parte do ecossistema</p>
        <div class="eco-grid">
          {
            ecosystemLinks.map((item) => (
              <a
                class:list={['eco-card', 'image' in item && item.image && 'eco-card--media']}
                href={item.href}
                target={item.current ? undefined : '_blank'}
                rel={item.current ? undefined : 'noopener noreferrer'}
                aria-current={item.current ? 'page' : undefined}
              >
                {'image' in item && item.image ? (
                  <span class="eco-thumb">
                    <img src={item.image} alt="" width="120" height="48" loading="lazy" />
                  </span>
                ) : (
                  <span class="eco-icon">
                    <TopicIcon name={item.icon} size={20} />
                  </span>
                )}
                <span class="eco-copy">
                  <span class="eco-title">{item.title}</span>
                  <span class="eco-desc">{item.description}</span>
                </span>
              </a>
            ))
          }
        </div>

        <div class="footdev">
          Desenvolvido por
          <a href="https://www.artesdosul.com/" target="_blank" rel="noopener noreferrer">Artes do Sul</a>
        </div>
      </div>
    </footer>
  </body>
</html>
