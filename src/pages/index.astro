---
export const prerender = true;

import BaseLayout from '../layouts/BaseLayout.astro';
import EntryCard from '../components/EntryCard.astro';
import { getAllEntries } from '../lib/entries';

const entries = getAllEntries();
const rotulagem = entries.filter((e) => e.trilha === 'rotulagem');
const outras = entries.filter((e) => e.trilha !== 'rotulagem');
---

<BaseLayout title="Sabor Brazil — Nem tudo é o que parece">
  <section class="hero">
    <div class="wrap">
      <p class="eyebrow">Catálogo aberto · fontes auditáveis</p>
      <h1 class="hero-title">
        NADA É<br />
        O QUE <span class="strike">PARECE</span>
      </h1>
      <p class="hero-sub">
        Produtos “sabor” disto e daquilo, mudanças regulatórias contestadas e divergências
        institucionais documentadas — cada entrada com fonte, status e denominação cruzada.
      </p>
      <div class="hero-actions">
        <a class="btn btn-primary" href="#catalogo">Explorar catálogo</a>
        <a class="btn" href="/contribuir">Encontrei um sabor</a>
      </div>
    </div>
    <div class="hero-stamp" aria-hidden="true">SELVA</div>
  </section>

  <section class="section" id="catalogo">
    <div class="wrap">
      <div class="section-head">
        <span class="section-tag">§ 01</span>
        <h2 class="section-title">Rotulagem</h2>
        <span class="section-count">{rotulagem.length} entradas</span>
      </div>
      {rotulagem.length === 0 ? (
        <p class="form-note">Nenhuma entrada publicada nesta trilha ainda.</p>
      ) : (
        <div class="grid">
          {rotulagem.map((entry, i) => <EntryCard entry={entry} delay={i * 60} />)}
        </div>
      )}
    </div>
  </section>

  {outras.length > 0 && (
    <section class="section">
      <div class="wrap">
        <div class="section-head">
          <span class="section-tag">§ 02</span>
          <h2 class="section-title">Regulatório & institucional</h2>
          <span class="section-count">{outras.length} entradas</span>
        </div>
        <div class="grid">
          {outras.map((entry, i) => <EntryCard entry={entry} delay={i * 60} />)}
        </div>
      </div>
    </section>
  )}
</BaseLayout>
