---
export const prerender = true;

import BaseLayout from '../layouts/BaseLayout.astro';
import EntryCard from '../components/EntryCard.astro';
import TopicIcon from '../components/TopicIcon.astro';
import { getAllEntries, TRILHAS, type Trilha } from '../lib/entries';
import { trilhaMeta } from '../lib/topic-icon';
import { PROJECT_HERO } from '../lib/heroes';

const entries = getAllEntries();
const byTrilha = Object.fromEntries(
  TRILHAS.map((t) => [t, entries.filter((e) => e.trilha === t)])
) as Record<Trilha, typeof entries>;
---

<BaseLayout title="Sabor Brazil — Nem tudo é o que parece">
  <section class="hero hero--with-cover">
    <div class="hero-cover" aria-hidden="true">
      <img src={PROJECT_HERO.src} alt="" width="1200" height="480" />
    </div>
    <div class="wrap hero-foreground">
      <p class="eyebrow">Catálogo aberto · fontes auditáveis</p>
      <h1 class="hero-title">
        NADA É<br />
        O QUE <span class="strike">PARECE</span>
      </h1>
      <p class="hero-sub">
        Rótulos, regras, procedimentos, preços e narrativas virais — cada entrada com fonte,
        status e o limite entre o dado e a conclusão.
      </p>
      <div class="hero-actions">
        <a class="btn btn-primary" href="#catalogo">Explorar catálogo</a>
        <a class="btn" href="/contribuir">Encontrei um sabor</a>
        <a class="btn" href="/sobre">Sobre</a>
      </div>

      <div class="trilha-pills">
        {
          TRILHAS.map((t) => (
            <a class="trilha-pill" href={`/trilha/${t}`}>
              <TopicIcon name={trilhaMeta[t].icon} size={16} />
              <span>
                <strong>{trilhaMeta[t].titulo}</strong>
                <small>{trilhaMeta[t].descricao}</small>
              </span>
            </a>
          ))
        }
      </div>
    </div>
    <div class="hero-stamp" aria-hidden="true">SELVA</div>
  </section>

  {
    TRILHAS.map((t, sectionIndex) => {
      const list = byTrilha[t];
      if (list.length === 0) return null;
      return (
        <section class="section" id={sectionIndex === 0 ? 'catalogo' : undefined}>
          <div class="wrap">
            <div class="section-head">
              <span class="section-tag">
                <TopicIcon name={trilhaMeta[t].icon} size={12} />
                § {String(sectionIndex + 1).padStart(2, '0')}
              </span>
              <h2 class="section-title">{trilhaMeta[t].titulo}</h2>
              <span class="section-count">{list.length} entradas</span>
            </div>
            <div class="grid">
              {list.map((entry, i) => (
                <EntryCard entry={entry} delay={i * 60} />
              ))}
            </div>
          </div>
        </section>
      );
    })
  }
</BaseLayout>
