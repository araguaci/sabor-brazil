---
export const prerender = true;

import { marked } from 'marked';
import BaseLayout from '../../layouts/BaseLayout.astro';
import {
  getAllEntries,
  getEntryById,
  statusClass,
  statusLabel,
  trilhaLabel,
} from '../../lib/entries';
import { topicIconForEntry } from '../../lib/topic-icon';
import { heroForEntryId } from '../../lib/heroes';
import TopicIcon from '../../components/TopicIcon.astro';

export function getStaticPaths() {
  return getAllEntries().map((entry) => ({
    params: { id: entry.slug },
  }));
}

const id = Astro.params.id!;
const entry = getEntryById(id);

if (!entry) {
  return Astro.redirect('/');
}

const html = marked.parse(entry.body, { async: false }) as string;
const icon = topicIconForEntry(entry);
const hero = heroForEntryId(entry.id);
---

<BaseLayout
  title={`${entry.titulo} — Sabor Brazil`}
  description={entry.resumo_neutro || entry.apresentacao_comercial || entry.titulo}
  image={hero?.src}
  ogType="article"
>
  <section class:list={['hero', 'hero--entry', hero && 'hero--entry-has-media']}>
    <div class:list={['wrap', hero && 'hero-entry-grid']}>
      <div class="hero-entry-copy">
        <p class="eyebrow">
          <TopicIcon name={icon} size={12} />
          {trilhaLabel(entry.trilha)} · {entry.id}
        </p>
        <h1 class="hero-title" style="max-width: 18ch; font-size: clamp(2.4rem, 7vw, 3.3rem);">
          {entry.titulo}
        </h1>
        <p class="hero-entry-meta">
          <span class="topic-badge" aria-hidden="true">
            <TopicIcon name={icon} size={18} />
          </span>
          <span class={`pill ${statusClass(entry.status)}`}>{statusLabel(entry.status)}</span>
        </p>
      </div>
      {
        hero && (
          <figure class="hero-entry-media">
            <img src={hero.src} alt={hero.alt} width="1024" height="600" />
          </figure>
        )
      }
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      {(entry.apresentacao_comercial || entry.denominacao_oficial) && (
        <dl class="compare">
          {entry.apresentacao_comercial && (
            <div class="parece">
              <dt>Parece</dt>
              <dd>{entry.apresentacao_comercial}</dd>
            </div>
          )}
          {entry.denominacao_oficial && (
            <div class="e">
              <dt>Denominação / o que a fonte diz</dt>
              <dd>{entry.denominacao_oficial}</dd>
            </div>
          )}
        </dl>
      )}

      {entry.comparacao_de_preco && (
        <dl class="compare">
          {entry.comparacao_de_preco.valor_contratado && (
            <div class="parece">
              <dt>Valor contratado</dt>
              <dd>{entry.comparacao_de_preco.valor_contratado}</dd>
            </div>
          )}
          {entry.comparacao_de_preco.valor_referencia && (
            <div class="e">
              <dt>Valor de referência</dt>
              <dd>{entry.comparacao_de_preco.valor_referencia}</dd>
            </div>
          )}
        </dl>
      )}

      {entry.comparacao_de_preco?.proporcao && (
        <p class="form-note" style="margin-bottom: 1.5rem;">
          Proporção: <strong style="color: var(--text)">{entry.comparacao_de_preco.proporcao}</strong>
        </p>
      )}

      {entry.dado_real?.afirmacao && (
        <dl class="compare">
          <div class="parece">
            <dt>Dado real</dt>
            <dd>
              {entry.dado_real.afirmacao}
              {entry.dado_real.fonte && (
                <span style="display:block;margin-top:0.5rem;color:var(--muted);font-size:0.9em">
                  Fonte: {entry.dado_real.fonte}
                </span>
              )}
            </dd>
          </div>
          {entry.salto_logico?.conclusao_alegada && (
            <div class="e">
              <dt>Salto lógico (não validado)</dt>
              <dd>{entry.salto_logico.conclusao_alegada}</dd>
            </div>
          )}
        </dl>
      )}

      {entry.salto_logico?.onde_quebra && (
        <p class="form-note" style="margin-bottom: 1.5rem;">
          Onde quebra: <strong style="color: var(--text)">{entry.salto_logico.onde_quebra}</strong>
        </p>
      )}

      {entry.orgao_regulador && (
        <p class="form-note" style="margin-bottom: 1.5rem;">
          Órgão: <strong style="color: var(--text)">{entry.orgao_regulador}</strong>
        </p>
      )}

      {entry.mecanismo_juridico && (
        <p class="form-note" style="margin-bottom: 1.5rem;">
          Mecanismo: <strong style="color: var(--text)">{entry.mecanismo_juridico}</strong>
        </p>
      )}

      {entry.dispositivo_legal && (
        <p class="form-note" style="margin-bottom: 1.5rem;">
          Dispositivo: <strong style="color: var(--text)">{entry.dispositivo_legal}</strong>
        </p>
      )}

      <article class="prose" set:html={html} />

      {entry.fontes?.length > 0 && (
        <div class="sources">
          <h2>Fontes</h2>
          <ul>
            {entry.fontes.map((f) => (
              <li>
                {f.url ? (
                  <a href={f.url} target="_blank" rel="noopener noreferrer">
                    {f.titulo}
                  </a>
                ) : (
                  <span>{f.titulo}</span>
                )}
                <span style="color: var(--dim)"> · {f.tipo}</span>
              </li>
            ))}
          </ul>
        </div>
      )}

      <p style="margin-top: 2.5rem;">
        <a class="btn" href={`/trilha/${entry.trilha}`}>← Voltar à trilha</a>
      </p>
    </div>
  </section>
</BaseLayout>
